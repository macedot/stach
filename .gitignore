# Deny all (whitelist mode)
*

# Allow directories to be traversed
!*/

# Allow only what this repo needs
!.gitignore
!README.md
!LICENSE
!Makefile
!src/
!src/**
!vendor/
!vendor/**
!testdata/
!testdata/**
!.github/
!.github/**
!benchmark/bench.sh
!benchmark/RESULTS.md
!benchmark/results.csv

# Still deny build artifacts / junk inside allowed trees
src/**/*.o
src/**/*.obj
vendor/**/*.o
vendor/**/*.obj
*.o
*.obj
*.lib
stach
stach.exe
*.zip
*.dylib
*.so
*.a
.DS_Store
